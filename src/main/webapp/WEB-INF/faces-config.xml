<?xml version="1.0" encoding="UTF-8"?>
<!-- Implementación: Mojarra 2.3.9 (JSF 2.3, javax.faces). Se declara el esquema 2.2 a propósito:
     con version="2.3" Mojarra activa su modo CDI y exige un BeanManager que Tomcat 9 no trae.
     Por eso los beans usan @ManagedBean. -->
<faces-config xmlns="http://xmlns.jcp.org/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_2.xsd"
              version="2.2">
    <application>
        <locale-config>
            <default-locale>es_PE</default-locale>
        </locale-config>
        <message-bundle>pe.com.dpaocookies.mensajes</message-bundle>
    </application>

    <!-- Navegación del acceso: el ingreso correcto lleva al tablero (panel de control).
         Si la cuenta no es válida, la acción devuelve null y JSF vuelve a mostrar el formulario
         con el mensaje junto a la contraseña. -->
    <navigation-rule>
        <from-view-id>/app/acceso.xhtml</from-view-id>
        <navigation-case>
            <from-action>#{acceso.ingresar}</from-action>
            <from-outcome>ingreso</from-outcome>
            <to-view-id>/app/tablero.xhtml</to-view-id>
            <redirect/>
        </navigation-case>
    </navigation-rule>

    <!-- Salir desde cualquier pantalla: la sesión se invalida y se vuelve al acceso. -->
    <navigation-rule>
        <from-view-id>/app/*</from-view-id>
        <navigation-case>
            <from-action>#{acceso.salir}</from-action>
            <from-outcome>salida</from-outcome>
            <to-view-id>/app/acceso.xhtml</to-view-id>
            <redirect/>
        </navigation-case>
    </navigation-rule>

    <!-- Las demás pantallas usan navegación implícita: cada acción de guardar devuelve
         «pagina?faces-redirect=true» (Post/Redirect/Get) y los enlaces usan h:link outcome. -->
</faces-config>
