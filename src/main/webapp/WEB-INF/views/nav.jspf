<%@ page pageEncoding="UTF-8" %>
<nav aria-label="Navegación principal">
    <a href="${pageContext.request.contextPath}/tablero" ${seccion == 'tablero' ? 'aria-current="page"' : ''}>Tablero</a>
    <a href="${pageContext.request.contextPath}/insumos" ${seccion == 'inventario' ? 'aria-current="page"' : ''}>Inventario</a>
    <a href="${pageContext.request.contextPath}/productos" ${seccion == 'productos' ? 'aria-current="page"' : ''}>Productos</a>
    <a href="${pageContext.request.contextPath}/kardex" ${seccion == 'kardex' ? 'aria-current="page"' : ''}>Kardex</a>
    <form action="${pageContext.request.contextPath}/salir" method="post">
        <input type="hidden" name="csrf" value="${sessionScope.csrf}">
        <button type="submit">Cerrar sesión</button>
    </form>
</nav>
