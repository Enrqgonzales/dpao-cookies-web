<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Productos | D'PAO COOKIES</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><p>D'PAO COOKIES</p><h1>Productos terminados</h1><%@ include file="nav.jspf" %></header><main><%@ include file="messages.jspf" %>
<section class="panel"><h2>Registrar producto</h2><p>El stock inicial es cero. Registra la producción en Kardex.</p><form method="post" action="${pageContext.request.contextPath}/productos"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="0"><div class="grid"><label>Código<input name="codigo" required maxlength="20"></label><label>Nombre<input name="nombre" required maxlength="100"></label><label>Precio S/<input name="precio" type="number" min="0" max="99999999.99" step="0.01" required></label><label>Categoría<select name="categoria" required><c:forEach var="c" items="${categorias}"><option value="${c.id_categoria}"><c:out value="${c.nombre}"/></option></c:forEach></select></label></div><button>Registrar producto</button></form></section>
<section class="panel"><h2>Catálogo</h2><div class="scroll"><table><thead><tr><th>ID</th><th>Código</th><th>Nombre</th><th>Precio S/</th><th>Stock</th><th>Editar</th></tr></thead><tbody><c:forEach var="p" items="${productos}"><tr><td>${p.id_producto}</td><td><c:out value="${p.codigo}"/></td><td><c:out value="${p.nombre}"/></td><td>${p.precio_venta}</td><td>${p.stock_actual}</td><td><details><summary>Editar producto</summary><form method="post" action="${pageContext.request.contextPath}/productos"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${p.id_producto}"><label>Código<input name="codigo" value="<c:out value='${p.codigo}'/>" maxlength="20" required></label><label>Nombre<input name="nombre" value="<c:out value='${p.nombre}'/>" maxlength="100" required></label><label>Precio S/<input name="precio" type="number" min="0" max="99999999.99" step="0.01" value="${p.precio_venta}" required></label><label>Categoría<select name="categoria"><c:forEach var="c" items="${categorias}"><option value="${c.id_categoria}" ${c.id_categoria == p.id_categoria ? 'selected' : ''}><c:out value="${c.nombre}"/></option></c:forEach></select></label><button>Guardar producto</button></form></details></td></tr></c:forEach></tbody></table></div></section></main></body></html>
