<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tablero | D'PAO COOKIES</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body>
<header><p>D'PAO COOKIES</p><h1>Tablero de operaciones</h1><%@ include file="nav.jspf" %></header><main><%@ include file="messages.jspf" %>
<div class="grid"><section class="card"><h2>Insumos</h2><p class="metric">${insumos.size()}</p><a href="${pageContext.request.contextPath}/insumos">Consultar inventario</a></section><section class="card"><h2>Reabastecer</h2><p class="metric">${bajoStock}</p><p>Stock menor o igual al mínimo.</p></section><section class="card"><h2>Productos</h2><p class="metric">${productos.size()}</p><a href="${pageContext.request.contextPath}/productos">Consultar catálogo</a></section></div>
<section class="panel"><h2>Alertas actuales</h2><c:forEach var="i" items="${insumos}"><c:if test="${i.bajoStock}"><p><strong><c:out value="${i.nombre}"/></strong> (<c:out value="${i.codigo}"/>): ${i.stockActual} <c:out value="${i.unidadMedida}"/> / mínimo ${i.stockMinimo} <c:out value="${i.unidadMedida}"/></p></c:if></c:forEach><c:if test="${bajoStock == 0}"><p>No hay insumos por reabastecer.</p></c:if><a href="${pageContext.request.contextPath}/kardex">Registrar o consultar movimientos</a></section></main></body></html>
